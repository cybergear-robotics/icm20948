CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ICM_20948_USE_DMP=y
CONFIG_ICM20948_I2C_SCL_GPIO=3
CONFIG_ICM20948_I2C_SDA_GPIO=9
CONFIG_ICM20948_I2C_CS_GPIO=18
CONFIG_ICM20948_I2C_AD0_GPIO=5
CONFIG_ICM20948_I2C_ADDRESS=0x69
CONFIG_ICM20948_I2C_INT_GPIO=4
